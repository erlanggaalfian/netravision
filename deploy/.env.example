# NetraVision v3.0 - contoh environment untuk deploy/docker-compose.yml
# Disalin menjadi deploy/.env oleh deploy/install.sh (tidak di-commit bila berisi secret).
# JANGAN commit file .env yang sudah terisi ke repo.

# --- PostgreSQL ---
POSTGRES_DB=netravision
POSTGRES_USER=netravision
# Dibuat otomatis oleh install.sh bila masih placeholder. Format: hex 32 char.
POSTGRES_PASSWORD=CHANGE_ME_GENERATED_BY_INSTALL_SH

# --- API (FastAPI) ---
# Port host (localhost saja) tempat API di-publish; Apache mem-proxy ke sini.
# Dipakai docker-compose.yml sebagai "127.0.0.1:${API_PORT:-8100}:8000" dan
# dibaca deploy/update.sh + deploy/install.sh dari file .env ini - ubah di
# satu tempat ini saja, jangan hardcode 8100 di tempat lain.
API_PORT=8100
# Lingkungan aplikasi: prod | dev. JANGAN pakai dev di server publik.
# Guard JWT_SECRET di app/core/config.py menolak secret default/pendek
# SELALU (bukan hanya bila APP_ENV=prod). Compose juga memakai
# ${APP_ENV:-prod} sebagai default bila variabel ini tidak ada di .env.
APP_ENV=prod
# WAJIB diisi dengan secret acak minimal 32 karakter sebelum deploy:
#   openssl rand -hex 32
# Nilai dikosongkan sengaja di contoh ini, JANGAN pakai nilai contoh
# atau placeholder apa pun; guard JWT menolak secret default/pendek
# dan API gagal start. install.sh mengisi otomatis bila kosong saat
# instalasi (openssl rand -hex 32). JANGAN commit .env yang terisi.
JWT_SECRET=
# Umur token (menit): access pendek + refresh rotation (pelajaran dari audit T10).
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Redis (internal, tidak ada port yang di-publish) ---
# Password Redis sebagai pertahanan berlapis bila network dipakai bersama
# service lain. Dibuat otomatis oleh install.sh bila masih placeholder.
REDIS_PASSWORD=CHANGE_ME_GENERATED_BY_INSTALL_SH

# --- WebRTC (wajib) ---
# IP/domain publik server untuk kandidat ICE WebRTC MediaMTX.
# WAJIB diisi: docker-compose.yml memakai ${WEBRTC_ADDITIONAL_HOST:?}
# dan compose GAGAL bila variabel ini kosong. install.sh mengisinya
# otomatis dari DOMAIN bila kosong (lihat deploy/install.sh).
# Isi dengan IP publik atau domain server, TANPA skema (tanpa https://).
# Contoh: WEBRTC_ADDITIONAL_HOST=netra.mamura.net.id
# CATATAN NAMA: variabel ini bernama WEBRTC_ADDITIONAL_HOST (tunggal).
# README.md:551 menulis WEBRTC_ADDITIONAL_HOSTS (jamak), itu salah ketik
# di README (di luar cakupan perbaikan ini, README tidak diedit) dan
# TIDAK akan dibaca compose. Pakai nama tunggal di sini.
WEBRTC_ADDITIONAL_HOST=

# --- Frontend ---
# URL publik (dipakai saat build static export bila perlu).
PUBLIC_BASE_URL=https://netra.mamura.net.id

# --- Rekaman: poster & retensi ---
POSTERS_ENABLED=true
POSTER_INTERVAL_SEC=60
RETENTION_ENABLED=true

# --- Google Drive (modul opsional, multi-akun) ---
DRIVE_ENABLED=false
DRIVE_FOLDER_ROOT=NetraVision
DRIVE_RETENTION_DAYS=30
# Kunci Fernet untuk enkripsi token OAuth akun Drive di DB (wajib bila DRIVE_ENABLED=true).
# Dibuat otomatis oleh install.sh bila masih placeholder. Format: base64 urlsafe 32-byte (44 karakter).
# Generate manual: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# JANGAN commit nilai aslinya. Lihat docs/GOOGLE-DRIVE.md §5 (generate & rotasi).
DRIVE_TOKEN_KEY=CHANGE_ME_GENERATED_BY_INSTALL_SH
# credentials.json (OAuth Web app) ditaruh manual di data/drive/ (lihat docs/GOOGLE-DRIVE.md §1).
# PUBLIC_BASE_URL wajib diset agar redirect_uri OAuth valid.
