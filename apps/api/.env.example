# NetraVision v3.0 — contoh konfigurasi environment.
# Salin ke .env lalu isi. JANGAN commit .env berisi rahasia asli.

APP_ENV=dev
APP_VERSION=3.0.0a0

# PostgreSQL (server diinstal via apt/systemd atau container; BUKAN di venv)
DATABASE_URL=postgresql+asyncpg://netravision:netravision@127.0.0.1:5432/netravision

# JWT — WAJIB diganti di produksi (string acak >= 32 karakter)
JWT_SECRET=CHANGE-ME-IN-PROD
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Login tamu ala v2.0 (nonaktif secara default)
GUEST_ENABLED=false
GUEST_PASSWORD=

# MediaMTX
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_WHEP_BASE=http://127.0.0.1:8889
# 4.11: kredensial control API MediaMTX (WAJIB diisi di produksi, password
# acak yang kuat; JANGAN commit nilainya). User default "netravision".
# Dipakai API (Basic auth) + mediamtx.yml (authInternalUsers).
MEDIAMTX_API_USER=netravision
MEDIAMTX_API_PASSWORD=

# 4.17: jaringan kamera yang boleh di-probe/scan (CIDR dipisah koma).
# Kosong = semua IP privat LAN diizinkan (loopback/link-local/metadata
# selalu ditolak). Isi bila kamera hanya di subnet tertentu.
CAMERA_NETWORKS=
# 4.17: izinkan probe ke loopback (127/8, ::1). MATI secara default.
# Hanya untuk tes otomatis (server RTSP palsu di 127.0.0.1) dan lab
# lokal; JANGAN nyalakan di produksi/demo (jalur SSRF ke layanan
# internal seperti MediaMTX control API dan Postgres).
CAMERA_PROBE_ALLOW_LOOPBACK=false

# 4.18: dokumentasi API FastAPI (/docs, /redoc, /openapi.json).
# Mati secara default; nyalakan hanya saat debugging lokal.
API_DOCS_ENABLED=false

# 4.8: CIDR proxy tepercaya untuk X-Forwarded-For (dipisah koma).
# Kosong = hanya loopback dipercaya. Di Docker compose, diisi default
# 172.16.0.0/12 (jaringan Docker) supaya IP asli dari Apache terbaca.
TRUSTED_PROXY_CIDRS=

# Poster (butuh ffmpeg di server; mati otomatis bila tak ada)
POSTERS_ENABLED=true
POSTER_INTERVAL_SEC=60

# Retensi lokal harian (per kamera: retention_days di DB)
RETENTION_ENABLED=true

# Google Drive — MODUL OPSIONAL, default nonaktif
DRIVE_ENABLED=false
DRIVE_CREDENTIALS_FILE=data/drive/credentials.json
DRIVE_TOKEN_FILE=data/drive/token.json
DRIVE_FOLDER_ROOT=NetraVision
DRIVE_RETENTION_DAYS=30

# CORS (JSON list)
CORS_ORIGINS=["http://localhost:3000"]

LOG_LEVEL=INFO
